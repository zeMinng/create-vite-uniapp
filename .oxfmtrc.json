{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "templates/",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".e2e-temp/"
  ]
}
